# Node.js dependencies (for root or sub-projects like backend/ or Final UI/)
node_modules/

# Next.js build output (for Final UI/ and potentially ++Final UI/ if it were tracked)
.next/
out/ # If Next.js uses static HTML export

# Environment variables (ALWAYS ignore these in Git)
.env
.env.local
.env.development.local
.env.production.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor/IDE specific files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
Thumbs.db

# npm package manager cache
.npm/
.eslintcache

# TypeScript cache
*.tsbuildinfo

# Directories to EXCLUDE based on your project structure clarification
# These are the folders you explicitly stated should NOT be pushed to GitHub:
++Final UI/
test-final-ui/

# Build directories for other potential sub-projects (e.g., if you have a separate backend build output)
# If your backend compiles to a 'dist' or 'build' folder, add them here relative to culturefix/:
backend/dist/
backend/build/

# Uploads directory (e.g., for resumes)
backend/uploads/

# Accidental command file, if it was created again
udo -u postgres psql
